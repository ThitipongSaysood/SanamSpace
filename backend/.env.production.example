# ---- SanamSpace API — production env template ----
# Copy to backend/.env on the server, then: php artisan key:generate

APP_NAME=SanamSpace
APP_ENV=production
APP_KEY=                      # generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.example.com    # or https://example.com when behind the edge nginx

APP_LOCALE=th
APP_TIMEZONE=Asia/Bangkok

# ---- Database (MySQL 8+) ----
DB_CONNECTION=mysql
DB_HOST=db                    # docker compose service name (or 127.0.0.1 on a VPS)
DB_PORT=3306
DB_DATABASE=sanamspace
DB_USERNAME=sanamspace
DB_PASSWORD=change-me-strong-password

# ---- Sessions / cache / queue (DB-backed; switch to redis for scale) ----
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- CORS (frontend origin; comma-separated). Leave blank/same-origin → set the real domain ----
CORS_ALLOWED_ORIGINS=https://example.com

# ---- File storage: local for dev; Cloudflare R2 / S3 for prod (slips, images) ----
FILESYSTEM_DISK=local
# For R2/S3 (recommended in prod) set FILESYSTEM_DISK=s3 and:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=sanamspace
# AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AWS_URL=https://cdn.example.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# ---- Mail / SMTP (invoices, receipts, broadcasts) ----
# In dev MAIL_MAILER=log writes mail to storage/logs/laravel.log.
# In PROD set MAIL_MAILER=smtp and fill the credentials of ONE provider below.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587                 # 587 = STARTTLS (tls), 465 = SSL
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=billing@yourco.com
MAIL_FROM_NAME="${APP_NAME}"
#
# Examples (uncomment one, fill creds):
#   Gmail / Google Workspace  → MAIL_HOST=smtp.gmail.com    MAIL_PORT=587  (use an App Password, not your login)
#   Mailgun                   → MAIL_HOST=smtp.mailgun.org  MAIL_PORT=587  MAIL_USERNAME=postmaster@mg.yourco.com
#   Amazon SES                → MAIL_HOST=email-smtp.<region>.amazonaws.com  MAIL_PORT=587  (SMTP credentials, not AWS keys)
#   Brevo / SendinBlue        → MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587
# After editing .env on the server: php artisan config:clear

# ---- LINE (customer login / messaging) — fill when integrating real LIFF ----
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_TOKEN=

LOG_CHANNEL=stack
LOG_LEVEL=warning
