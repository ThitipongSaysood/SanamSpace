# ---- LINE (customer login / messaging) ----
# When LINE_CHANNEL_ID is set, POST /auth/line/login REQUIRES a LIFF-verified
# id_token (verified against LINE_VERIFY_URL). Leave blank for the dev/test
# stub (trusts the supplied lineUserId). Must match the frontend NEXT_PUBLIC_LIFF_ID.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_TOKEN=
# LINE_VERIFY_URL=https://api.line.me/oauth2/v2.1/verify

VITE_APP_NAME="${APP_NAME}"
