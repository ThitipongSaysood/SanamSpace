# ---- SanamSpace Customer/Owner/Admin web — production env template ----
# NEXT_PUBLIC_* is inlined at BUILD time — set it before `next build`
# (for Docker it's a build ARG). Changing it requires a rebuild.

# Same-origin behind the edge nginx (recommended): API is proxied under /api/v1
NEXT_PUBLIC_API_URL=/api/v1

# Split-host alternative (frontend and API on different domains):
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
