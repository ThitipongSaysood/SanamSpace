# Credentials for the docker-compose `db` service. Copy to `.env` (gitignored) and edit.
# These MUST match DB_DATABASE/DB_USERNAME/DB_PASSWORD in backend/.env.
DB_DATABASE=sanamspace
DB_USERNAME=sanamspace
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-root-password

# Build-time API URL for the Next app (inlined). Same-origin behind nginx:
NEXT_PUBLIC_API_URL=/api/v1
